#!/usr/bin/env python3
"""Open the configured Steam Personal Cloud dashboard in the desktop browser."""
import json
from pathlib import Path
import subprocess
import sys

CONFIG = Path.home() / '.config/steam-personal-cloud/client.json'
try:
    url = json.loads(CONFIG.read_text())['server']
    if not (url.startswith('http://') or url.startswith('https://')):
        raise ValueError('Invalid server URL')
except (OSError, KeyError, ValueError, json.JSONDecodeError):
    print('Configure Steam Personal Cloud first: steam-personal-cloud-setup', file=sys.stderr)
    sys.exit(1)
subprocess.Popen(['xdg-open', url], start_new_session=True)
